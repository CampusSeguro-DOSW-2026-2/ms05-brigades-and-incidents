package edu.eci.dosw.brigades_and_incidents.event;

import org.junit.jupiter.api.Test;
import org.springframework.context.ApplicationEventPublisher;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

class IncidenteAuditPublisherTest {

    @Test
    void debePublicarEventoDeAuditoria() {
        ApplicationEventPublisher eventPublisher =
                mock(ApplicationEventPublisher.class);

        IncidenteAuditPublisher publisher =
                new IncidenteAuditPublisher(eventPublisher);

        publisher.publicar(
                "INCIDENTE_CREADO",
                "INCIDENTE",
                "incidente-123",
                "evento-456",
                "usuario-789",
                "EXITOSO",
                "Incidente creado correctamente"
        );

        verify(eventPublisher, times(1)).publishEvent(any(Object.class));
    }

    @Test
    void debePublicarUnEventoInclusoCuandoLosDatosOpcionalesSonNulos() {
        ApplicationEventPublisher eventPublisher =
                mock(ApplicationEventPublisher.class);

        IncidenteAuditPublisher publisher =
                new IncidenteAuditPublisher(eventPublisher);

        publisher.publicar(
                "CONSULTA",
                "INCIDENTE",
                null,
                null,
                null,
                "EXITOSO",
                null
        );

        verify(eventPublisher, times(1)).publishEvent(any(Object.class));
    }
}