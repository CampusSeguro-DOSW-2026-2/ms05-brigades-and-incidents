
# ==========================================
# BASE DE DATOS (instancia administrada RDS)
# ==========================================
# Una base por entorno. El endpoint es el de la instancia; `sslmode=require` es obligatorio
# porque la instancia tiene `rds.force_ssl=1` (una conexión sin cifrar se rechaza).
SPRING_DATASOURCE_URL=jdbc:postgresql://database-ms05.cv2f07iwqjsk.us-east-1.rds.amazonaws.com:5432/brigades_incidents_db?sslmode=require
# Rol de la aplicación (NO es el usuario maestro de RDS). Distinto por entorno.
SPRING_DATASOURCE_USERNAME=ms05_user
SPRING_DATASOURCE_PASSWORD=CAMBIAR_PASSWORD

# ==========================================
# INTEGRACION CON API GATEWAY
# ==========================================
GATEWAY_URL=http://localhost:8080
GATEWAY_SERVICE_KEY=CAMBIAR_CLAVE
GATEWAY_SYSTEM_USER_=ms05-service
